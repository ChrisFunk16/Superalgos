    { "id": "chaos",   "start": 0.0,  "end": 20.0, "bars": "1-10",  "idea": "Drei Insellösungen, die nicht zusammenpassen. Spannung baut sich auf, dann Atempause." },
    { "id": "clarity", "start": 20.0, "end": 52.0, "bars": "11-26", "idea": "Linkado: sechs Nutzenversprechen, die nacheinander einrasten. Ruhiger Groove wächst Schicht für Schicht." },
    { "id": "finale",  "start": 52.0, "end": 60.0, "bars": "27-30", "idea": "Alles kristallisiert zum Linkado-Logo. Abschlusszeile, Ausklang." }
