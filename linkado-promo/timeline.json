  "scenes": [
    { "id": "hook",      "start": 0.0,  "end": 2.0,  "bars": "1",     "text": "Alles funktioniert. Nur nicht dazwischen." },
    { "id": "m365",      "start": 2.0,  "end": 6.0,  "bars": "2-3",   "text": "Der Allrounder – alles aus einer Hand, aber: abhängig vom Anbieter · Kosten wachsen mit · nicht auf dich zugeschnitten" },
    { "id": "opendesk",  "start": 6.0,  "end": 10.0, "bars": "4-5",   "text": "Das fertige Portal – offen und lokal gedacht, aber: nur Oberfläche und Anmeldung · Werkzeuge bleiben einzeln · kein durchgängiges Erlebnis" },
    { "id": "nextcloud", "start": 10.0, "end": 14.0, "bars": "6-7",   "text": "Die offene Basis – mächtig und frei, aber: Pflege bleibt bei dir · roh im Alltag · viel Technik, wenig Erlebnis" },
    { "id": "overwhelm", "start": 14.0, "end": 18.0, "bars": "8-9",   "text": "Fünf Blickwinkel: Noch ein Login (Mitarbeitende). Noch ein Tool (Teams). Noch ein Abo (Geschäftsführung). Noch eine KI (Datenschutz). Noch eine Frage an die IT." },
    { "id": "pause",     "start": 18.0, "end": 20.0, "bars": "10",    "text": "Es geht auch anders." },

    { "id": "reveal",    "start": 20.0, "end": 24.0, "bars": "11-12", "text": "Nextcloud als Basis. Linkado als Benutzererlebnis. – Technik verständlich und zugänglich machen." },
    { "id": "overview",  "start": 24.0, "end": 28.0, "bars": "13-14", "text": "Mehr Übersicht im Arbeitsalltag. – Anwendungen und wichtige Funktionen leichter finden." },
    { "id": "appshop",   "start": 28.0, "end": 34.0, "bars": "15-17", "text": "Passende Werkzeuge an einem Ort. – Apps über den Linkado-Appshop auswählen und verwalten." },
    { "id": "help",      "start": 34.0, "end": 40.0, "bars": "18-20", "text": "Hilfe direkt in der Cloud. – Anleitungen und Support dort, wo Fragen entstehen." },
    { "id": "package",   "start": 40.0, "end": 46.0, "bars": "21-23", "text": "Ein stimmiges Gesamtpaket. – Oberfläche, Erweiterungen und Betreuung greifen ineinander." },
    { "id": "time",      "start": 46.0, "end": 54.0, "bars": "24-27", "text": "Mehr Zeit fürs Wesentliche. – Weniger mit Technik beschäftigen, leichter zusammenarbeiten." },

    { "id": "finale",    "start": 54.0, "end": 64.0, "bars": "28-32", "text": "Linkado. Die Möglichkeiten von Nextcloud. Einfach für deinen Alltag. – Der offene Arbeitsplatz." }
  ],

